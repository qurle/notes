---
import NoteLayout from '@layouts/NoteLayout.astro'
import { unique } from '@scripts/utils/unique'
import { Icon } from 'astro-icon/components'
import settings from '@settings'

export const allFiles = Object.keys(
  import.meta.glob<Record<string, any>>(
    ['./*.{astro,html,mdx,md}', './**/*.{astro,html,mdx,md}'],
    { eager: true, query: '?url' },
  ),
)

// Global fuzzy-search dataset: every folder and page across the whole site,
// with absolute hrefs and root-relative names. Identical on every page, so it's
// built once here rather than per route.
const searchFolders = unique(
  allFiles
    .map((path) => path.replace(/^\.\//, ''))
    .filter((rel) => rel.includes('/'))
    .flatMap((rel) =>
      rel
        .split('/')
        .slice(0, -1)
        .map((_, i, arr) => arr.slice(0, i + 1).join('/') + '/'),
    ),
)

const searchItems = [
  ...searchFolders.map((rel) => ({ name: rel, href: '/' + rel, type: 'folder' })),
  ...allFiles.map((path) => ({
    name: path.replace(/^\.\//, ''),
    href: path.replace(/^\.(.+)\.[^.]+$/, '$1'),
    type: 'page',
  })),
]

export function getStaticPaths() {
  const folders = unique(
    allFiles
      // Only folders
      .filter((path) => path.split('/').length > 2)
      // Remove files from routes
      .map((path) => path.replace(/^\.\/|\/[^\/]*$/g, ''))
      // Add each folder on the way
      .flatMap((folder) =>
        folder
          .split('/')
          .map((_, i, arr) => arr.slice(0, i + 1).join('/') + '/'),
      ),
  )

  return [
    ...folders.map((folder) => ({ params: { folder } })),
    { params: { folder: '' } },
  ]
}

const { folder } = Astro.params
const currentPath = folder ? `./${folder}/` : './'
const currentFolder = folder?.split('/').at(-1)

const title = folder ? currentFolder + '/' : settings.rootTitle

const contents = allFiles.filter((path) => path.startsWith(currentPath))

const nextLevelFolders = new RegExp(
  `^${currentPath.replace(/\./g, '\\.')}([^/]+/)`,
)

const folders = unique(
  contents
    .filter((path) => path.replace(currentPath, '').split('/').length > 1)
    .map((path) => path.match(nextLevelFolders)?.[1])
    .filter(Boolean),
)

const pages = contents
  .filter((path) => path.replace(currentPath, '').split('/').length === 1)
  .map((path) => ({
    href: path.replace(/^\.(.+)\.[^.]+$/, '$1'),
    name: path.split('/').at(-1),
  }))
---

<NoteLayout {title}>
  <h1>{title}</h1>
  <div class="search">
    <input
      class="search-input"
      type="text"
      placeholder="search"
      aria-label="Search all notes"
      autocomplete="off"
      spellcheck="false"
    />
    <button class="search-clear" type="button" aria-label="Close search" hidden>
      <Icon name="material-symbols:close" />
    </button>
  </div>
  <ul class="entries">
    {
      folders.map((path) => (
        <li class="folder">
          <a href={path}>{path}</a>
        </li>
      ))
    }
    {folders.length > 0 && pages.length > 0 && <hr />}
    {
      pages.map(({ href, name }) => (
        <li>
          <a href={href}>{name}</a>
        </li>
      ))
    }
  </ul>
  <script
    type="application/json"
    id="search-data"
    set:html={JSON.stringify(searchItems)}
  />
</NoteLayout>
<script>
  import { initFolderNavigation } from '@scripts/navigate'
  import { initSearch } from '@scripts/search'
  initFolderNavigation()
  initSearch()
</script>
