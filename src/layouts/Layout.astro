---
import Icons from '@components/utils/Icons.astro'
import '@styles/global.sass'
import settings from '@settings'

const defaultTitle = settings.title
const {
  title = defaultTitle,
  simpleTitle = false,
  description = settings.description,
  class: className,
} = Astro.props

let pageTitle = defaultTitle
if (title !== defaultTitle)
  pageTitle = simpleTitle ? title : `${title} | ${defaultTitle}`

const base = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/'
---

<!doctype html>
<html
  lang="en"
  data-font={settings.appearance.font.default}
  data-theme={settings.appearance.theme.default}
>
  <head>
    <base href={base} target="_self" />
    <meta charset="UTF-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!settings.indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta
      name="viewport"
      content="width=device-width initial-scale=1 interactive-widget=resizes-content"
    />
    <meta name="theme-color" content="#f8f8f8" />

    <meta name="msapplication-TileColor" content="#575757" />
    <meta name="msapplication-navbutton-color" content="#161616" />
    <meta name="apple-mobile-web-app-status-bar-style" content="#161616" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:image" content="/og/main.png" />
    <meta property="vk:image" content="/og/main-vk.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og/main.png" />

    <Icons />

    <script is:inline>
      // This thing comes inline to avoid flickering when your
      // theme is not default. Sorry, just saving your eyes!
      function loadMode(mode) {
        const value = localStorage.getItem(mode)
        if (value && value !== 'undefined') {
          document.documentElement.dataset[mode] = value
        }
      }
      loadMode('theme')
      loadMode('font')

      // Keep the browser chrome color in sync with the loaded theme
      const themeColors = {
        light: '#f8f8f8',
        dark: '#161616',
        digital: '#001108',
      }
      const theme = document.documentElement.dataset.theme
      const themeMeta = document.querySelector('meta[name="theme-color"]')
      if (themeMeta && themeColors[theme])
        themeMeta.setAttribute('content', themeColors[theme])
    </script>
  </head>
  <body class={className}>
    <slot />
  </body>
</html>
